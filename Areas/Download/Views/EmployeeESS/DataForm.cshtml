<div ng-app="HRIS">
    <div ng-controller="EmployeeESSController" ng-init="formLoaded()" id="ngForm">
        <fieldset>
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Employee Default ESSs</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button type="button" id="btnExtract" ng-click="tbExtract()" title="Click to extract Employee(s) default ESS setup on selected criteria" class="download" />
                                <button type="button" id="btnExport" ng-click="tbExport()" class="export" title="Click to Export the data" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td colspan="10">
                            <div class="divEmployeeESSGrid">
                                <div ag-grid="grdOptEmployeeESS" id="grdEmployeeESS" class="ag-theme-bootstrap" style="height: 100%; width:auto; max-width:100%;"></div>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </fieldset>
    </div>
    <script src='~/Areas/Download/JS/EmployeeESS.js' type="text/javascript"></script>
    <link rel="stylesheet" type="text/css" href="~/Areas/Download/CSS/EmployeeESS.css" />
    <script src='~/Scripts/Agility/agGridHelper.js' type="text/javascript"></script>
</div>

