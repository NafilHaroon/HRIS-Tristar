<div ng-app="HRIS">
    <div ng-controller="JVBookController" ng-init="formLoaded()" id="ngForm">
        <form id="frmJV">
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Journal Voucher</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button ng-click="tbSearch()" id="btnFind" class="find" title="Click to Search Journal Voucher from last 32 days" />
                                <button type="button" id="btnRecall" ng-click="tbRecall()" title="Click to recall existing record" class="recall" />
                                <button type="button" id="btnAdd" ng-click="tbAdd()" title="Click to create new JV Book" class="add" />
                                <button type="button" id="btnEdit" title="Click to edit this JVBook" class="edit" />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Save the current record" class="save" />
                                <button type="button" id="btnUndo" ng-click="tbUndo()" title="Click to clear the request" class="undo" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="primaryKey">Voucher #</label>
                        </td>
                        <td>
                            <input type="text" id="txtVoucherNo" ng-model="JVBook.VoucherNo" numbers-only ng-keyup="$event.keyCode == 13  ? getJVoucherByNo(JVBook.VoucherNo) : null" maxlength="10" class="form-control tb150" />
                            <input type="hidden" id="hdVoucherId" ng-model="JVBook.VoucherId" />
                        </td>
                        <td>
                            <label class="mandatoryKey">Voucher Date</label>
                        </td>
                        <td>
                            <input type="text" ng-model="JVBook.VoucherDate" id="dpVoucher" maxlength="11" class="form-control dateField" />
                        </td>
                        <td colspan="4" />
                        <td colspan="2" />
                    </tr>

                    <tr>
                        <td>
                            <label>Remarks</label>
                        </td>
                        <td colspan="3">
                            <input type="text" ng-model="JVBook.Remarks" maxlength="100" class="form-control tb350" id="txtRemarks" />
                        </td>
                    </tr>

                    <tr>
                        <td colspan="5">
                            <div class="divJVBookGrid">
                                <div class="divToolbar">
                                    <button ng-click="onAddLine()" class="add" title="Add Line Item"></button>
                                    <button ng-click="onDeleteLine()" class="delete" title="Remove Select Line Item"></button>
                                </div>
                                <div ag-grid="grdOptJVBook" id="grdJVBook" class="ag-theme-fresh" style="height: 80%; width:auto; max-width:100%;"></div>
                            </div>
                        </td>
                        <td colspan="4">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>

                </table>
            </div>

            <footer>
                <ng-include src="'/HRIS/Helper/Pages/Footer.html'" />
            </footer>
        </form>
    </div>
    <script src='~/Areas/PF/JS/JVBook.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/SearchHelper.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/agGridHelper.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/DateHelper.js' type="text/javascript"></script>
    <link rel="stylesheet" type="text/css" href="~/Areas/PF/CSS/JVBook.css"/>
    <link rel="stylesheet" type="text/css" href='~/Scripts/jQuery/jquery.ui.datepicker.css' />
</div>
