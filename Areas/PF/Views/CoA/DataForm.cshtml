<div ng-app="HRIS">
    <div ng-controller="CoAController" ng-init="formLoaded()" id="ngForm">
        <form id="frmCoA">
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Chart of Accounts</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button ng-click="tbSearch()" id="btnFind" class="find" title="Click to Search Chart of Accounts from lookup list" />
                                <button type="button" id="btnRecall" ng-click="tbRecall()" title="Click to recall existing record" class="recall" />
                                <button type="button" id="btnAdd" ng-click="tbAdd()" title="Click to create new Chart of Accounts" class="add" />
                                <button type="button" id="btnEdit" title="Click to edit this Chart of Accounts" class="edit" />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Save the current record" class="save" />
                                <button type="button" id="btnUndo" ng-click="tbUndo()" title="Click to clear the request" class="undo" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="primaryKey">Account Code</label>
                        </td>
                        <td>
                            <input type="text" id="txtAccountCode" ng-model="CoA.AccountCode" ng-keyup="$event.keyCode == 13  ? getCoAById(CoA.AccountCode) : null" maxlength="6" class="form-control tb100" />
                        </td>
                        <td colspan="2">
                            <md-switch id="chkBankAccount" ng-disabled="true" ng-model="CoA.BankAccount"> {{CoA.BankAccount ? "Bank A/c" : "Non-Bank A/c"}}</md-switch>
                        </td>
                        <td colspan="3" />
                        <td colspan="3" />
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Acccount Name</label>
                        </td>
                        <td>
                            <input type="text" id="txtAccountName" ng-model="CoA.AccountName" maxlength="50" class="form-control tb350" />
                        </td>
                        <td colspan="2"/>
                        <td colspan="4" rowspan="5">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Account Type</label>
                        </td>
                        <td>
                            <select ng-options="c.AccountTypeId as c.AccountTypeName for c in lstAccountType"
                                    ng-model="CoA.AccountTypeId" class="form-control tb250" id="ddAccountType">
                                <option disabled value="">-Select Account Type-</option>
                            </select>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Opening Balance</label>
                        </td>
                        <td>
                            <input type="text" ng-model="CoA.OpeningBalance" value="0" onkeypress="return isDecimalKey(event)" onblur="return Decimal2Places(event, value)"
                                   maxlength="20 " class="form-control tb100 tbRA" id="txtOpeningBalance"/>
                        </td>
                    </tr>
                </table>
            </div>

            <footer>
                <ng-include src="'/HRIS/Helper/Pages/Footer.html'" />
            </footer>
        </form>
    </div>
    <script src='~/Areas/PF/JS/CoA.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/SearchHelper.js' type="text/javascript"></script>
</div>