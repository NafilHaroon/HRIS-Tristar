<div ng-app="HRIS">
    <div ng-controller="LoanController" ng-init="formLoaded()" id="ngForm">
        <fieldset>
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Loan</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button ng-click="tbSearch()" id="btnFind" class="find" title="Click to Search 'Open' Loan Entries from lookup list" />
                                <button type="button" id="btnRecall" ng-click="tbRecall()" title="Click to recall existing record" class="recall" />
                                <button type="button" id="btnAdd" ng-click="tbAdd()" title="Click to create new Loan Entry" class="add" />
                                <button type="button" id="btnEdit" title="Click to edit this Loan Entry" class="edit" />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Save the current record" class="save" />
                                <button type="button" id="btnUndo" ng-click="tbUndo()" title="Click to clear the request" class="undo" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="primaryKey">Loan Id</label>
                        </td>
                        <td>
                            <input type="text" id="txtLoanId" ng-model="Loan.LoanId" numbers-only ng-keyup="$event.keyCode == 13  ? getLoanById(Loan.LoanId) : null" maxlength="6" class="form-control tb100 tbRA" />
                        </td>
                        @*<td>
                <div class="form-check">
                    <input type="checkbox" ng-model="Loan.IsActive" class="form-check-input" id="chkActive" disabled />
                    <label class="form-check-label" for="chkActive">Is Active?</label>
                </div>
            </td>
            <td />*@
                        <td>
                            <label>Status</label>
                        </td>
                        <td>
                            <input type="text" ng-model="Loan.StatusName" readonly tabindex="-1" id="txtStatus" />
                        </td>
                        <td colspan="4" />
                        <td colspan="2" />
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Employee</label>
                        </td>
                        <td colspan="2">
                            @*<select ng-options="e.EmployeeId as e.EmployeeName for e in lstEmployee"
                                    ng-model="Loan.EmployeeId" class="form-control tb300" id="ddEmployee">
                                <option disabled value="">-Select Employee-</option>
                            </select>*@
                            <input type="text" ng-model="Loan.Employee" typeahead-editable="false"
                                   uib-typeahead="e as e.EmployeeName for e in lstEmployee | filter:$viewValue | limitTo:8"
                                   class="form-control ta300 tbUC" typeahead-show-hint="true" typeahead-min-length="2"
                                   typeahead-select-on-exact="true" typeahead-select-on-blur="true" id="ddEmployee"
                                   placeholder="-Select Employee-" title="Type minimum 2 characters to see the matching list">
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Loan Type</label>
                        </td>
                        <td>
                            <select ng-options="lt.LoanTypeId as lt.LoanTypeName for lt in lstLoanType"
                                    ng-model="Loan.LoanTypeId" class="form-control tb200" id="ddLoanType">
                                <option disabled value="">-Select Loan Type-</option>
                            </select>
                        </td>
                        <td>
                            <label class="mandatoryKey">Loan Amount</label>
                        </td>
                        <td>
                            <input type="number" max="9999999" min="100" ng-model="Loan.LoanAmount" ng-maxlength="8" class="tb100 tbRA" placeholder="0" />
                        </td>

                        <td>
                            <label class="mandatoryKey">Balance</label>
                        </td>
                        <td>
                            <input type="number" ng-model="Loan.Balance" ng-maxlength="9" class="tb100 tbRA" readonly tabindex="-1" />
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Deduction From</label>
                        </td>
                        <td>
                            <select ng-options="p.PeriodId as p.PeriodName for p in lstPeriod"
                                    ng-model="Loan.PeriodId" class="form-control tb200" id="ddPeriod">
                                <option disabled value="">-Select Starting Month-</option>
                            </select>
                        </td>
                        <td>
                            <label class="mandatoryKey">Installment (Months)</label>
                        </td>
                        <td>
                            <input type="number" max="99" min="1" ng-model="Loan.Installments" ng-maxlength="2" placeholder="0" class="form-control tb100 tbRA" />
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Reason</label>
                        </td>
                        <td colspan="3">
                            <textarea id="txtReason" rows="5" cols="50" maxlength="200" class="form-control tb300" ng-model="Loan.Reason"></textarea>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="4" rowspan="3">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>

            <footer>
                <ng-include src="'/HRIS/Helper/Pages/Footer.html'" />
            </footer>
        </fieldset>
    </div>
    <script src='~/Areas/Transaction/JS/Loan.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/SearchHelper.js' type="text/javascript"></script>
    <link href='~/Content/CSS/TypeAhead.css' rel="stylesheet" type="text/css" />
</div>

