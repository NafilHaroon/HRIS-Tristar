<div ng-app="HRIS">
    <div ng-controller="SalaryCreditController" ng-init="formLoaded()" id="ngForm">
        <fieldset>
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Salary Credit Letter</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button ng-click="tbSearch()" id="btnFind" class="find" title="Click to Search Salary Credit Letter from lookup list" />
                                <button type="button" id="btnRecall" ng-click="tbRecall()" title="Click to recall existing record" class="recall" />
                                <button type="button" id="btnAdd" ng-click="tbAdd()" title="Click to create new Salary Credit Letter" class="add" />
                                <button type="button" id="btnEdit" title="Click to unfreeze this screen" class="edit" />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Save the current record" class="save" />
                                <button type="button" id="btnUndo" ng-click="tbUndo()" title="Click to clear the request" class="undo" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="primaryKey">Letter Id</label>
                        </td>
                        <td>
                            <input type="text" id="txtLetterId" ng-model="SalaryLetter.LetterId" ng-keyup="$event.keyCode == 13  ? getSalaryLetterById(SalaryLetter.LetterId) : null" maxlength="4" class="form-control tb60 tbRA" />
                        </td>
                        <td>
                            <label class="mandatoryKey">Letter Date</label>
                        </td>
                        <td>
                            <input type="text" ng-model="SalaryLetter.LetterDate" id="dpLetter" maxlength="11" class="form-control dateField" />
                        </td>

                        <td colspan="4" />
                        <td>
                            <input type="text" style="display:none" id="hdnPrinted" ng-model="SalaryLetter.Printed"/>
                        </td>
                        <td />
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Bank A/c</label>
                        </td>
                        <td>
                            <select ng-options="ba.BankId as ba.BankName for ba in lstBank"
                                    ng-model="SalaryLetter.BankId" class="form-control tb200" id="ddBank">
                                <option disabled value="">-Select Bank-</option>
                            </select>
                        </td>
                        <td>
                            <label class="mandatoryKey">Salary Period</label>
                        </td>
                        <td>
                            <select ng-options="p.PeriodId as p.PeriodName for p in lstPeriod"
                                    ng-model="SalaryLetter.PeriodId" class="form-control tb200" id="ddPeriod">
                                <option disabled value="">-Select Period-</option>
                            </select>
                        </td>
                        <td>
                            <button ng-click="tbLoad()" id="btnLoad" class="load" title="Click to load the Employee Detail" />
                        </td>
                        <td colspan="4" rowspan="2">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label>Remarks</label>
                        </td>
                        <td colspan="3">
                            <textarea id="txtRemarks" rows="3" cols="50" maxlength="500" class="form-control tb500" ng-model="SalaryLetter.Remarks"></textarea>
                        </td>
                        <td colspan="3">
                            <img src="~/Content/Images/BankLock.jpg" ng-show="SalaryLetter.Printed" title="This Letter was Previewed/Printed hence no further chnages are allowed to this Letter" />
                        </td>
                    </tr>
                    <tr>
                        <td colspan="8">                            
                            <div class="divSalaryLetterGrid">
                                <div ag-grid="grdOptSalaryLetter" id="grdSalaryLetter" class="ag-theme-fresh" style="height:80%;  max-width:100%;"></div>
                            </div>
                        </td>
                    </tr>

                </table>
            </div>

            <footer>
                <ng-include src="'/HRIS/Helper/Pages/Footer.html'" />
            </footer>
        </fieldset>
    </div>
    <script src='~/Areas/Transaction/JS/SalaryCredit.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/SearchHelper.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/DateHelper.js' type="text/javascript"></script>
    <link href="~/Areas/Transaction/CSS/SalaryCredit.css" rel="stylesheet" type="text/css" />
    <script src='~/Scripts/Agility/agGridHelper.js' type="text/javascript"></script>
</div>

