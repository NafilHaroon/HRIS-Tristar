<div ng-app="HRIS">
    <div ng-controller="LeaveController" ng-init="formLoaded()" id="ngForm">
        <fieldset>
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Monthly Leave</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button ng-click="tbSearch()" id="btnFind" class="find" title="Click to Search Leave Entry from lookup list" />
                                <button type="button" id="btnRecall" ng-click="tbRecall()" title="Click to recall existing record" class="recall" />
                                <button type="button" id="btnAdd" ng-click="tbAdd()" title="Click to create new Leave Entry" class="add" />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Save the current record" class="save" />
                                <button type="button" id="btnUndo" ng-click="tbUndo()" title="Click to clear the request" class="undo" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="primaryKey">Reference #</label>
                        </td>
                        <td>
                            <input type="text" id="txtReferenceId" ng-model="Leave.DetailId" ng-keyup="$event.keyCode == 13  ? getLeaveById(Leave.DetailId) : null" maxlength="7" class="form-control tb100 tbRA" />
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Employee</label>
                        </td>
                        <td colspan="2">
                            <select ng-options="e.EmployeeId as e.EmployeeName for e in lstEmployee"
                                    ng-model="Leave.EmployeeId" class="form-control tb300" id="ddEmployee">
                                <option disabled value="">-Select Employee-</option>
                            </select>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Leave Type</label>
                        </td>
                        <td>
                            <select ng-options="l.LeaveTypeId as l.LeaveTypeName for l in lstLeaveType"
                                    ng-model="Leave.LeaveTypeId" class="form-control tb200" id="ddLeaveType">
                                <option disabled value="">-Select Leave Type-</option>
                            </select>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Date From</label>
                        </td>
                        <td>
                            <input type="text" ng-model="Leave.DateFrom" id="dpFrom" maxlength="11" class="form-control dateField" />
                        </td>
                        <td>
                            <label class="mandatoryKey">Date To</label>
                        </td>
                        <td>
                            <input type="text" ng-model="Leave.DateTo" id="dpTo" maxlength="11" class="form-control dateField" />
                        </td>
                        <td>
                            <md-switch ng-disabled="true" ng-model="Leave.HalfDay" title="Turn on to mark leave as Half Day">Half Day Leave</md-switch>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Reason</label>
                        </td>
                        <td colspan="3">
                            <textarea id="txtReason" rows="5" cols="50" maxlength="100" class="form-control tb300" ng-model="Leave.Reason"></textarea>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="4" rowspan="3">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
            <footer>
                <ng-include src="'/HRIS/Helper/Pages/Footer.html'" />
            </footer>
        </fieldset>
    </div>
    <script src='~/Areas/Transaction/JS/Leave.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/DateHelper.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/SearchHelper.js' type="text/javascript"></script>
    <link rel="stylesheet" type="text/css" href='~/Scripts/jQuery/jquery.ui.datepicker.css' />
</div>

