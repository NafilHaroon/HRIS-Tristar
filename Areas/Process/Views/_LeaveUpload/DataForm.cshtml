<html>
<head title="Leave Upload">
    <title>Leave Upload</title>
</head>

<body ng-app="HRIS">
    <div ng-controller="LeaveUploadController" ng-init="formLoaded()" id="ngForm">
        <fieldset>
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Leave Upload</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button type="button" id="btnExport" ng-click="tbExport()" class="export" title="Click to Export data " />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to upload the Leave data" class="upload" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">First Date</label>
                        </td>
                        <td align="left">
                            <input type="text" ng-model="FirstDay" id="dtFirstDay" maxlength="11" class="form-control dateField" />
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">File Upload</label>
                        </td>
                        <td colspan="3" >
                            <div style="float: left;">
                                <input type="file" name="UploadedFile" style="align-content:stretch; width:25vw;"
                                       accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
                                       data-val="true" id="fuAttachment"
                                       @*data-val-required=" oops, select the attachment first!"*@
                                       data-val-accept="Sorry, we only accept Excel format." />
                            </div>
                        </td>
                        <td colspan="4" rowspan="2">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td />
                        <td >
                            @Html.ActionLink("Download  Template", "DownloadLUTemplate", "LeaveUpload",
                            new
                            {
                                @target = "_blank",
                                @class = "Template",
                                title = "Click to download LeaveUpload Template, you can use this template to upload Leave Upload line items from excel"
                            })
                        </td>
                    </tr>

                    <tr>
                        <td colspan="6">
                            <div class="divLUploadScreen">
                                <div class="divLUploadGrid">
                                    <div ag-grid="grdOptLUpload" id="grdLUpload" class="ag-theme-fresh" style="height: 80%; width:auto; max-width:100%;"></div>
                                </div>
                            </div>

                        </td>
                    </tr>

                </table>
            </div>
        </fieldset>
    </div>
    <script src='~/Areas/Process/JS/LeaveUpload.js' type="text/javascript"></script>
    <link rel="stylesheet" type="text/css" href="~/Areas/Process/CSS/LeaveUpload.css" />
    <script src='~/Scripts/Agility/DateHelper.js' type="text/javascript"></script>

</body>
</html>

