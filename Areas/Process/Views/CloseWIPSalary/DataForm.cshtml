<div ng-app="HRIS">
    <div ng-controller="CloseWIPSalaryController" ng-init="formLoaded()" id="ngForm">
        <fieldset>
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Close WIP Salary</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Mark selected Employee(s) Salary as Verified & Closed" class="verify"/>
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td colspan="10">
                            <div class="divCloseWIPSalaryGrid">
                                <div ag-grid="grdOptCloseWIPSalary" id="grdCloseWIPSalary" class="ag-theme-fresh" style="height: 100%; width:auto; max-width:100%;"></div>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td colspan="4">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
        </fieldset>
    </div>
    <script src='~/Areas/Process/JS/CloseWIPSalary.js' type="text/javascript"></script>
    <link rel="stylesheet" type="text/css" href="~/Areas/Process/CSS/CloseWIPSalary.css" />
    <script src='~/Scripts/Agility/agGridHelper.js' type="text/javascript"></script>
</div>

