<html>
<head title="Leave Entitlement Upload">
    <title>Leave Entitlement Upload</title>
</head>

<body ng-app="HRIS">
    <div ng-controller="LeaveEntitlementUploadController" ng-init="formLoaded()" id="ngForm">
        <fieldset>
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Leave Entitlement Upload</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button type="button" id="btnExport" ng-click="tbExport()" class="export" title="Click to Export data " />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to upload the Leave Entitlement data" class="upload" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">File Upload</label>
                        </td>
                        <td colspan="3">
                            <div style="float: left;">
                                <input type="file" name="UploadedFile" style="align-content:stretch; width:25vw;"
                                       accept="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel"
                                       data-val="true" id="fuAttachment"
                                       @*data-val-required=" oops, select the attachment first!"*@
                                       data-val-accept="Sorry, we only accept Excel format." />
                            </div>
                        </td>
                        <td colspan="4" rowspan="2" >
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td />
                        <td>
                            @Html.ActionLink("Download Template", "DownloadLEUTemplate", "LeaveEntitlementUpload",
                                new
                                {
                                    @target = "_blank",
                                    @class = "Template",
                                    title = "Click to download Leave Entitlement Upload Template, you can use this template to upload Leave Entitlement Upload line items from excel"
                                })
                        </td>
                    </tr>

                    <tr>
                        <td colspan="6">
                            <div class="divLEUploadScreen">
                                <div class="divLEUploadGrid">
                                    <div ag-grid="grdOptLEUpload" id="grdLEUpload" class="ag-theme-fresh" style="height: 80%; width:auto; max-width:100%;"></div>
                                </div>
                            </div>

                        </td>
                    </tr>
                </table>
            </div>
        </fieldset>
    </div>
    <script src='~/Areas/Process/JS/LeaveEntitlementUpload.js' type="text/javascript"></script>
    <link rel="stylesheet" type="text/css" href="~/Areas/Process/CSS/LeaveEntitlementUpload.css" />
</body>
</html>

