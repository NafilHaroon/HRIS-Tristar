@{
    Layout = "~/Views/Shared/LoginLayout.cshtml";
}

    <form name="Login" ng-app="HRIS" ng-controller="UserController" ng-submit="login();" id="ngForm">
        <table align="center" class="loginTable">
            <tr>
                <td colspan="2" align="center">
                    <label class="loginTitle">User Credentials Required</label>
                </td>
            </tr>
            <tr>
                <td>
                    <label class="mandatoryKey">User Id</label>
                </td>
                <td>
                    <input type="text" id="txtUserId" ng-init="UserProfile.UserId=''" ng-model="UserProfile.UserId" required />
                </td>
            </tr>
            <tr>
                <td>
                    <label class="mandatoryKey">Password</label>
                </td>
                <td>
                    <input id="password" name="password" type="password" ng-init="UserProfile.Password=''" data-ng-model="UserProfile.Password" required />
                </td>
            </tr>
            <tr>
                <td colspan="2" align="center">
                    <button type="submit" id="btnLogOn" ng-disabled="Login.$invalid">Sign In</button>
                    <button type="button" id="btnSendPassword" ng-click="SendPassword()">Forgot Password</button>
                </td>
            </tr>
        </table>
    </form>

<script src='~/Scripts/Angular/angular.js' type="text/javascript"></script>
<script src='~/Scripts/jquery-3.3.1.min.js' type="text/javascript"></script>
<script src='~/Scripts/jQuery/jquery-ui-1.12.1.min.js' type="text/javascript"></script>
<script src='~/Scripts/Angular/angular-animate.min.js'></script>
<script src='~/Scripts/Angular/angular-aria.min.js' type="text/javascript"></script>
<script src='~/Scripts/Angular/angular-messages.min.js' type="text/javascript"></script>
<script src='~/Scripts/Angular/angular-material.min.js' type="text/javascript"></script>
<script src='~/Scripts/angular-ui/ui-bootstrap.min.js' type="text/javascript"></script>
<script src='~/Scripts/angular-ui/ui-bootstrap-tpls.min.js' type="text/javascript"></script>

<link href='~/Content/themes/PepperGrinder/jquery-ui.min.css' rel="stylesheet" type="text/css" />
<link href='~/Content/angular-material.min.css' rel="stylesheet" type="text/css" />
<link href='~/Content/bootstrap.min.css' rel="stylesheet" type="text/css" />

<script src='~/Scripts/Agility/FormHelper.js' type="text/javascript"></script>
<script src='~/Areas/Common/JS/LogIn.js' type="text/javascript"></script>
<script src='~/Areas/Common/JS/ChangePassword.js' type="text/javascript"></script>

<link href='~/Areas/Common/CSS/LogIn.css' rel="stylesheet" type="text/css" />

<div id="dialog-alert" style="display: none; overflow:hidden; background-color:whitesmoke;">
    <img src="~/Content/Images/LoginClock.gif" class="processingGIF" />
    <h5>Authentication in Progress, Please standby....</h5>
</div>