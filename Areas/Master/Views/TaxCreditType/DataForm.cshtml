<div ng-app="HRIS">
    <div ng-controller="TaxCreditTypeController" ng-init="formLoaded()" id="ngForm">
        <fieldset>
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Tax Credit Type</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button ng-click="tbSearch()" id="btnFind" class="find htmlactionlink" title="Click to Search Tax Credit from lookup list" />
                                <button type="button" id="btnRecall" ng-click="tbRecall()" title="Click to recall existing Tax Credit" class="recall" />
                                <button type="button" id="btnAdd" ng-click="tbAdd()" title="Click to create new Tax Credit" class="add" />
                                <button type="button" id="btnEdit" title="Click to edit this Tax Credit" class="edit" />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Save the current record" class="save" />
                                <button type="button" id="btnUndo" ng-click="tbUndo()" title="Click to clear the request" class="undo" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="primaryKey">Credit Type Id</label>
                        </td>
                        <td>
                            <input type="text" id="txtTaxCreditTypeId" ng-model="TaxCreditType.TaxCreditTypeId" numbers-only ng-keyup="$event.keyCode == 13 ? getTaxCreditTypeById(TaxCreditType.TaxCreditTypeId) : null" maxlength="2" class="form-control tb60 tbRA" />
                        </td>
                        <td>
                            <div class="form-check">
                                <input type="checkbox" ng-model="TaxCreditType.IsActive" class="form-check-input" id="chkActive" disabled />
                                <label class="form-check-label" for="chkActive">Is Active?</label>
                            </div>
                        </td>
                        <td colspan="4" />
                        <td colspan="2" />
                        <td />
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Credit Type Name</label>
                        </td>
                        <td>
                            <input type="text" ng-model="TaxCreditType.TaxCreditTypeName" id="txtTaxCreditTypeName" maxlength="50" class="form-control tb300" />
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Credit Rule</label>
                        </td>
                        <td>
                            <select ng-options="tc.CreditRuleId as tc.CreditRuleName for tc in lstCreditRule"
                                    ng-model="TaxCreditType.CreditRuleId" class="form-control tb350" id="ddCreditRule">
                                <option disabled value="">-Select Credit Rule-</option>
                            </select>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Amount Threshold
                                <label title="Keep Amount Threshold to 0 to make it unlimited" class="infoText">&#128712;</label>
                            </label>
                        </td>
                        <td>
                            <input type="number" ng-model="TaxCreditType.MaxAmount" maxlength="10" value="0" min="0" max="100000000s" class="form-control tb100 tbRA" />
                        </td>

                        <td>
                            <label class="mandatoryKey" ng-show="TaxCreditType.CreditRuleId != 98 && TaxCreditType.CreditRuleId != 99">Threshold (%)</label>
                        </td>
                        <td>
                            <input type="number" ng-model="TaxCreditType.MaxRate" ng-show="TaxCreditType.CreditRuleId != 98 && TaxCreditType.CreditRuleId != 99" maxlength="5" min="0" max="100.00" value="0" class="form-control tb80 tbRA" />
                        </td>
                    </tr>

                    <tr>
                        <td colspan="4">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>

            <footer>
                <ng-include src="'/HRIS/Helper/Pages/Footer.html'" />
            </footer>
        </fieldset>
    </div>
    <script src='~/Areas/Master/JS/TaxCreditType.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/SearchHelper.js' type="text/javascript"></script>
</div>
