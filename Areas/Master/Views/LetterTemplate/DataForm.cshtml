<body ng-app="HRIS">
    <div ng-controller="TemplateController" ng-init="formLoaded()" id="ngForm">
        <fieldset>
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Letter Template</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button ng-click="tbSearch()" id="btnFind" class="find" title="Click to Search Letter Template from lookup list" />
                                <button type="button" id="btnRecall" ng-click="tbRecall()" title="Click to recall existing record" class="recall" />
                                <button type="button" id="btnAdd" ng-click="tbAdd()" title="Click to create new Letter Template" class="add" />
                                <button type="button" id="btnEdit" ng-click="tbEdit()" title="Click to edit this Letter Template" class="edit" />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Save the current record" class="save" />
                                <button type="button" id="btnUndo" ng-click="tbUndo()" title="Click to clear the request" class="undo" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="primaryKey">Template Id</label>
                        </td>
                        <td>
                            <input type="text" id="txtTemplateId" ng-model="Template.TemplateId" numbers-only ng-keyup="$event.keyCode == 13  ? getTemplateById(Template.TemplateId) : null" maxlength="3" class="form-control tb60 tbRA" />
                        </td>
                        <td>
                            <div class="form-check">
                                <input type="checkbox" ng-model="Template.IsActive" class="form-check-input" id="chkActive" disabled />
                                <label class="form-check-label" for="chkActive">Is Active?</label>
                            </div>
                        </td>
                        <td />
                        <td colspan="2">
                            <md-switch ng-disabled="true" ng-model="Template.ImpactsPayroll">Impacts Payroll?</md-switch>
                        </td>
                        <td colspan="2">
                            <md-switch ng-disabled="true" ng-model="Template.IncludeSeparatedEmployees" title="If turned on, will show separated employees in the list for this template in addition to active employees">Include Separated Employees?</md-switch>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Template Name</label>
                        </td>
                        <td>
                            <input type="text" id="txtTemplateName" ng-model="Template.TemplateName" maxlength="50" class="form-control tb250" />
                        </td>

                        <td>
                            <label class="mandatoryKey">Letter Prefix</label>
                        </td>
                        <td>
                            <input type="text" ng-model="Template.LetterPrefix" maxlength="5" class="form-control tb100" />
                        </td>
                        <td>
                            <label class="mandatoryKey">Document Type</label>
                        </td>
                        <td>
                            <select ng-options="dt.DocumentTypeId as dt.DocumentTypeName for dt in lstDocumentType" ng-model="Template.DocumentTypeId" class="form-control tb200" id="ddDocumentType">
                                <option disabled value="">-Select Document Type-</option>
                            </select>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Template</label>
                        </td>
                        <td>
                            <label title="Click to see database variable list for mapping in Letter Body to automatically pick the value while generating letter"
                                   ng-click="showVariables()" style="cursor:pointer; user-select:none; font-weight:bolder;">&#128712;</label>
                        </td>
                    </tr>
                    <tr>
                        <td rowspan="10" colspan="8">
                            <textarea ui-tinymce="tinymceOptions" ng-model="Template.TemplateContent" rows="10" cols="50" id="txtTemplateContent"></textarea>
                        </td>
                        <td rowspan="10" colspan="2">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
            <footer>
                <ng-include src="'/HRIS/Helper/Pages/Footer.html'" />
            </footer>
        </fieldset>
    </div>
    <script src='~/Scripts/tinymce/tinymce.min.js' type="text/javascript"></script>
    <script src='~/Scripts/angular-ui-tinymce/src/tinymce.js' type="text/javascript"></script>
    <script src='~/Areas/Master/JS/LetterTemplate.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/SearchHelper.js' type="text/javascript"></script>
</body>
