<div ng-app="HRIS">
    <div ng-controller="CalendarController" ng-init="formLoaded()" id="ngForm">
        <fieldset>
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Calendar</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button type="button" id="btnRecall" ng-click="tbRecall()" title="Click to recall existing record" class="recall" />
                                <button type="button" id="btnEdit" title="Click to edit this Calendar" class="edit" />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Save the current record" class="save" />
                                <button type="button" id="btnUndo" ng-click="tbUndo()" title="Click to clear the request" class="undo" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <label class="mandatoryKey">Period</label>
                        </td>
                        <td>
                            <select ng-options="e.PeriodId as e.PeriodName for e in lstPeriod"
                                    ng-model="Calendar.PeriodId" ng-change="getCalendarById(Calendar.PeriodId)" class="form-control tb200" id="ddPeriod">
                                <option disabled value="">-Select Period-</option>
                            </select>
                        </td>
                        <td />
                        <td />
                        <td colspan="4" rowspan="3" valign="top">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>


                    <tr>
                        <td colspan="4">
                            <div class="divCalendarScreen">
                                <div class="divCalendarGrid">
                                    <div ag-grid="grdOptCalendar" id="grdCalendar" class="ag-theme-fresh" style="height: 80%; width:auto; max-width:100%;"></div>
                                </div>
                            </div>
                        </td>
                    </tr>

                </table>
            </div>
        </fieldset>
    </div>
    <script src='~/Areas/Master/JS/Calendar.js' type="text/javascript"></script>
    <link rel="stylesheet" type="text/css" href="~/Areas/Master/CSS/Calendar.css" />
    <script src='~/Scripts/Agility/agGridHelper.js' type="text/javascript"></script>
</div>

