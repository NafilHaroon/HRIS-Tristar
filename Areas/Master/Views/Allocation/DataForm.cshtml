<body ng-app="HRIS">
    <div ng-controller="AllocationController" ng-init="formLoaded()" id="ngForm">
        <fieldset>
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Cost Allocation Template</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button ng-click="tbSearch()" id="btnFind" class="find" title="Click to Search Template from lookup list" />
                                <button type="button" id="btnRecall" ng-click="tbRecall()" title="Click to recall existing record" class="recall" />
                                <button type="button" id="btnAdd" ng-click="tbAdd()" title="Click to create new Template" class="add" />
                                <button type="button" id="btnEdit" title="Click to edit this Template" class="edit" />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Save the current record" class="save" />
                                <button type="button" id="btnUndo" ng-click="tbUndo()" title="Click to clear the request" class="undo" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="primaryKey">Template Id</label>
                        </td>
                        <td>
                            <input type="text" id="txtTemplateId" ng-model="Allocation.TemplateId" numbers-only ng-keyup="$event.keyCode == 13 ? getTemplateById(Allocation.TemplateId) : null" maxlength="3" class="form-control tb60 tbRA" />
                        </td>
                        <td>
                            <div class="form-check">
                                <input type="checkbox" ng-model="Allocation.IsActive" class="form-check-input" id="chkActive" disabled />
                                <label class="form-check-label" for="chkActive">Is Active?</label>
                            </div>
                        </td>
                        <td colspan="2" />
                        <td colspan="3" />
                        <td colspan="2" />
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Template Name</label>
                        </td>
                        <td colspan="2">
                            <input type="text" id="txtTemplateName" ng-model="Allocation.TemplateName" maxlength="50" class="form-control tb350" />
                        </td>
                        <td colspan="2" />
                        <td colspan="4" rowspan="2">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td colspan="4">
                            <div class="divDepartmentScreen">
                                <div class="divDepartmentGrid">
                                    <div class="divToolbar">
                                        <button ng-click="onAddAllocation()" class="add" title="Add Department"></button>
                                        <button ng-click="onDeleteAllocation()" class="delete" title="Remove Department"></button>
                                    </div>
                                    <div ag-grid="grdOptAllocation" id="grdAllocation" class="ag-theme-fresh" style="height: 80%; width:auto; max-width:100%;"></div>
                                </div>
                            </div>
                        </td>
                    </tr>

                </table>
            </div>

            <footer>
                <ng-include src="'/HRIS/Helper/Pages/Footer.html'" />
            </footer>
        </fieldset>
    </div>
    <script src='~/Areas/Master/JS/Allocation.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/SearchHelper.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/agGridHelper.js' type="text/javascript"></script>
    <link rel="stylesheet" type="text/css" href="~/Areas/Master/CSS/Allocation.css" />
</body>

