<body ng-app="HRIS">
    <div ng-controller="BranchController" ng-init="formLoaded()" id="ngForm">
        <fieldset>
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Branch</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button ng-click="tbSearch()" id="btnFind" class="find htmlactionlink" title="Click to Search Branch from lookup list" />
                                <button type="button" id="btnRecall" ng-click="tbRecall()" title="Click to recall existing Branch" class="recall" />
                                <button type="button" id="btnEdit" title="Click to edit this Branch" class="edit" />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Save the current record" class="save" />
                                <button type="button" id="btnUndo" ng-click="tbUndo()" title="Click to clear the request" class="undo" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="primaryKey">Branch Code</label>
                        </td>
                        <td>
                            <input type="text" id="txtBranchCode" ng-model="Branch.BranchCode" ng-keyup="$event.keyCode == 13  ? getBranchByCode(Branch.BranchCode) : null" maxlength="2" class="form-control tb60 tbRA" />
                            <input type="hidden" id="hdBranchCode" ng-model="Branch.BranchCode" />
                        </td>
                        <td>
                            <div class="form-check">
                                <input type="checkbox" ng-model="Branch.IsActive" class="form-check-input" id="chkActive" disabled />
                                <label class="form-check-label" for="chkActive">Is Active?</label>
                            </div>
                        </td>
                        <td colspan="4" />
                        <td colspan="2" />
                        <td />
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Branch Name</label>
                        </td>
                        <td>
                            <input type="text" ng-model="Branch.BranchName" class="form-control tb200" readonly />
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label>Social Security (%)</label>
                        </td>
                        <td>
                            <input id="numSSRate" ng-model="Branch.SSRate" type="number" oninput="return check(event,value)" onkeypress="return isDecimalKey(event)" min="0" max="100" step="0.1" value="0" maxlength="5" class="form-control tb70 tbRA" />
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label>SS Max Contribution</label>
                        </td>
                        <td>
                            <input type="text" ng-model="Branch.SSMaxAmount" maxlength="11" class="form-control tb100 tbRA" onkeypress="return isDecimalKey(event)" onblur="return Decimal2Places(event, value)" value="0" placeholder="0.00" />
                        </td>
                    </tr>

                    <tr>
                        <td colspan="4">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>

            <footer>
                <ng-include src="'/HRIS/Helper/Pages/Footer.html'" />
            </footer>
        </fieldset>
    </div>
    <script src='~/Areas/Master/JS/Branch.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/SearchHelper.js' type="text/javascript"></script>
</body>