<body ng-app="HRIS">
    <div ng-controller="SalaryHeadController" ng-init="formLoaded()"  id="ngForm">
        <fieldset>
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Salary Head</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button ng-click="tbSearch()" id="btnFind" class="find" title="Click to Search Salary Head from lookup list" />
                                <button type="button" id="btnRecall" ng-click="tbRecall()" title="Click to recall existing record" class="recall" />
                                <button type="button" id="btnAdd" ng-click="tbAdd()" title="Click to create new Salary Head" class="add" />
                                <button type="button" id="btnEdit" title="Click to edit this SalaryHead" class="edit" />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Save the current record" class="save" />
                                <button type="button" id="btnUndo" ng-click="tbUndo()" title="Click to clear the request" class="undo" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="primaryKey">Head Id</label>
                        </td>
                        <td>
                            <input type="text" id="txtHeadId" ng-model="SalaryHead.HeadId"  numbers-only  ng-keyup="$event.keyCode == 13  ? getSalaryHeadById(SalaryHead.HeadId) : null" maxlength="3" class="form-control tb60 tbRA" />
                        </td>
                        <td>
                            <div class="form-check">
                                <input type="checkbox" ng-model="SalaryHead.IsActive" class="form-check-input" id="chkActive" disabled />
                                <label class="form-check-label" for="chkActive">Is Active?</label>
                            </div>
                        </td>
                        <td colspan="2" />
                        <td colspan="3" />
                        <td colspan="2" />
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Head Name</label>
                        </td>
                        <td>
                            <input type="text" id="txtHeadName" ng-model="SalaryHead.HeadName" maxlength="50" class="form-control tb250" />
                        </td>
                        <td colspan="2">
                            <md-switch ng-disabled="true" ng-model="SalaryHead.IncludeInSalarySheet">Part of Salary Sheet</md-switch>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Head Type</label>
                        </td>
                        <td>
                            <select ng-options="ht.HeadTypeId as ht.HeadTypeName for ht in lstHeadType"
                                    ng-model="SalaryHead.HeadTypeId" class="form-control tb200" id="ddHeadtype">
                                <option disabled value="">-Select Head Type-</option>
                            </select>
                        </td>
                        <td colspan="2">
                            <md-switch ng-disabled="true" ng-model="SalaryHead.AbsentDeduction">Deduct for Absent Days</md-switch>
                        </td>
                        <td>
                            <md-switch ng-disabled="true" ng-model="SalaryHead.SystemCalculated">System Head</md-switch>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Default Amount</label>
                        </td>
                        <td>
                            <input id="numAmount" ng-model="SalaryHead.DefaultAmount" type="number" oninput="return Decimal2Places(event,value)" onkeypress="return isDecimalKey(event)" value="0" maxlength="20" class="form-control tb100 tbRA" />
                        </td>
                        <td colspan="2">
                                <md-switch ng-model="SalaryHead.Arrears">Arrears Head</md-switch>
                        </td>
                        <td colspan="2">
                            <md-switch ng-model="SalaryHead.ITaxExempted">Exempted from Income Tax</md-switch>
                        </td>
                    </tr>

                    <tr>
                        <td colspan="4">
                            <div class="divWorkerTypeScreen">
                                <div class="divWorkerTypeGrid">
                                    <div class="divToolbar">
                                        <button ng-click="onAddWorkerType()" class="add" title="Add Woker Type"></button>
                                        <button ng-click="onDeleteWWorkerType()" class="delete" title="Remove Worker Type"></button>
                                    </div>
                                    <div ag-grid="grdOptWorkerType" id="grdWorkerType" class="ag-theme-fresh" style="height: 80%; width:auto; max-width:100%;"></div>
                                    <label style="font-size:8px; color:red;">This list only contains mapping for current company</label>
                                </div>
                            </div>
                        </td>
                        <td colspan="4" rowspan="3">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>

            <footer>
                <ng-include src="'/HRIS/Helper/Pages/Footer.html'" />
            </footer>
        </fieldset>
    </div>
    <script src='~/Areas/Master/JS/SalaryHead.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/SearchHelper.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/agGridHelper.js' type="text/javascript"></script>
    <link rel="stylesheet" type="text/css" href="~/Areas/Master/CSS/SalaryHead.css" />
</body>

