<div ng-app="HRIS">
    <div ng-controller="UserProfileController" ng-init="formLoaded()" id="ngForm">
        <fieldset>
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">User Management</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button ng-click="tbSearch()" id="btnFind" class="find htmlactionlink" title="Click to Search User  from lookup list" />
                                <button type="button" id="btnRecall" ng-click="tbRecall()" title="Click to recall existing User" class="recall" />
                                <button type="button" id="btnEdit" title="Click to edit this User" class="edit" />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Save the current record" class="save" />
                                <button type="button" id="btnUndo" ng-click="tbUndo()" title="Click to clear the request" class="undo" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="primaryKey">UserId</label>
                        </td>
                        <td>
                            <input type="text" id="txtUserId" ng-model="UserProfile.UserId" ng-keyup="$event.keyCode == 13  ? getUserProfileById(UserProfile.UserId) : null" maxlength="20" class="form-control tb150" />
                            <input type="hidden" id="hdUserId" ng-model="UserProfile.UserId" />
                        </td>
                        <td>
                            <div class="form-check">
                                <input type="checkbox" ng-model="UserProfile.UserActive" class="form-check-input" id="chkActive" readonly />
                                <label class="form-check-label" for="chkActive">Is Active?</label>
                            </div>
                        </td>
                        <td colspan="4" />
                        <td colspan="2" />
                        <td />
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">User Name</label>
                        </td>
                        <td>
                            <input type="text" ng-model="UserProfile.UserName" class="form-control tb250" readonly />
                        </td>
                        <td>
                            <label class="mandatoryKey">Department Name</label>
                        </td>
                        <td>
                            <input type="text" ng-model="UserProfile.DepartmentName" class="form-control tb250" readonly />
                        </td>
                        <td colspan="4" rowspan="3">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Branch Name</label>
                        </td>
                        <td>
                            <input type="text" ng-model="UserProfile.BranchName" class="form-control tb250" readonly />
                        </td>
                        <td>
                            <label class="mandatoryKey">User Email</label>
                        </td>
                        <td>
                            <input type="text" ng-model="UserProfile.EmailId" class="form-control tb250" readonly />
                        </td>
                    </tr>

                    <tr>
                        <td colspan="4">
                            <div class="row" style="border:1px blue solid; margin:5px; padding-top:5px;">
                                <ul class="nav nav-pills flex-column col-sm-1 col-md-1 col-lg-1" role="tablist" aria-orientation="horizontal">
                                    <li class="nav-item">
                                        <a class="nav-link active" role="tab" href="#tbUserOption" data-toggle="pill" accesskey="tabPanel" title="User Options">
                                            <img src="~/Content/Icon/Options.png" class="navlinkImg" />
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" role="tab" href="#tbUserBranch" data-toggle="pill" accesskey="tabPanel" title="User Branch">
                                            <img src="~/Content/Icon/Branch.png" class="navlinkImg" />
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" role="tab" href="#tbUserCompany" data-toggle="pill" accesskey="tabPanel" title="User Company">
                                            <img src="~/Content/Icon/company.jpg" class="navlinkImg" />
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" role="tab" href="#tbUserGrade" data-toggle="pill" accesskey="tabPanel" title="User Grade">
                                            <img src="~/Content/Icon/Grade.jpg" class="navlinkImg" />
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link" role="tab" href="#tbUserRole" data-toggle="pill" accesskey="tabPanel" title="User Role">
                                            <img src="~/Content/Icon/Role.jpg" class="navlinkImg" />
                                        </a>
                                    </li>
                                </ul>
                                <div class="col-sm-11 col-md-11 col-lg-11">
                                    <div class="tab-content">
                                        <div id="tbUserOption" class="tab-pane fade show active" role="tabpanel">
                                            <div class="divOptionScreen">
                                                <div class="divOptionGrid">
                                                    <div ag-grid="grdOptOption" id="grdOption" class="ag-theme-fresh" style="height: 80%; width:auto; max-width:100%;"></div>
                                                </div>
                                            </div>
                                        </div>
                                        <div id="tbUserBranch" class="tab-pane fade" role="tabpanel">
                                            <div class="divBranchScreen">
                                                <div class="divBranchGrid">
                                                    <div ag-grid="grdOptBranch" id="grdBranch" class="ag-theme-fresh" style="height: 80%; width:auto; max-width:100%;"></div>
                                                </div>
                                            </div>
                                        </div>
                                        <div id="tbUserCompany" class="tab-pane fade" role="tabpanel">
                                            <div class="divCompanyScreen">
                                                <div class="divCompanyGrid">
                                                    <div ag-grid="grdOptCompany" id="grdCompany" class="ag-theme-fresh" style="height: 80%; width:auto; max-width:100%;"></div>
                                                </div>
                                            </div>
                                        </div>
                                        <div id="tbUserGrade" class="tab-pane fade" role="tabpanel">
                                            <div class="divGradeScreen">
                                                <div class="divGradeGrid">
                                                    <div ag-grid="grdOptGrade" id="grdGrade" class="ag-theme-fresh" style="height: 80%; width:auto; max-width:100%;"></div>
                                                </div>
                                            </div>
                                        </div>
                                        <div id="tbUserRole" class="tab-pane fade" role="tabpanel">
                                            <div class="divRoleScreen">
                                                <div class="divRoleGrid">
                                                    <div ag-grid="grdOptRole" id="grdRole" class="ag-theme-fresh" style="height: 80%; width:auto; max-width:100%;"></div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>

            <footer>
                <ng-include src="'/HRIS/Helper/Pages/Footer.html'" />
            </footer>
        </fieldset>
    </div>
    <script src='~/Areas/Master/JS/UserProfile.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/SearchHelper.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/agGridHelper.js' type="text/javascript"></script>
    <link rel="stylesheet" type="text/css" href="~/Content/CSS/TabControl.css" />
    <link rel="stylesheet" type="text/css" href="~/Areas/Master/CSS/UserProfile.css" />
</div>