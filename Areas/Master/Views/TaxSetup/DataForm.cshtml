<body ng-app="HRIS">
    <div ng-controller="TaxSetupController" ng-init="formLoaded()"  id="ngForm">
        <fieldset>
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Salary Head</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button type="button" id="btnRecall" ng-click="tbRecall()" title="Click to recall existing record" class="recall" />
                                <button type="button" id="btnEdit" title="Click to edit this Tax Setup" class="edit" />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Save the current record" class="save" />
                                <button type="button" id="btnUndo" ng-click="tbUndo()" title="Click to clear the request" class="undo" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="primaryKey">Tax Year</label>
                        </td>
                        <td>
                            <select ng-options="e.TaxYear as e.TaxYear for e in lstTaxYear"
                                    ng-model="TaxSetup.TaxYear" ng-change="getTaxSetupByYear(TaxSetup.TaxYear)" class="form-control tb100" id="ddPeriod">
                                <option disabled value="">-Select Tax Year-</option>
                            </select>
                        </td>
                        <td>
                            <label class="mandatoryKey">PF Threshold</label>
                        </td>
                        <td>
                            <input type="number" id="txtPFThreshold" ng-model="TaxSetup.PFThreshold" maxlength="9" class="form-control tb120" />
                        </td>
                        <td colspan="2" />
                        <td colspan="3" />
                        <td />
                    </tr>

                    <tr>
                        <td colspan="5">
                            <div class="divTaxSetupGrid">
                                <div class="divToolbar">
                                    <button ng-click="onAddTaxSlab()" class="add" title="Add Tax Slab"></button>
                                    <button ng-click="onDeleteTaxSlab()" class="delete" title="Remove Tax Slab"></button>
                                </div>
                                <div ag-grid="grdOptTaxSetup" id="grdTaxSetup" class="ag-theme-fresh" style="height: 80%; width:auto; max-width:100%;"></div>
                            </div>
                        </td>
                        <td colspan="4" rowspan="3">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>

            <footer>
                <ng-include src="'/HRIS/Helper/Pages/Footer.html'" />
            </footer>
        </fieldset>
    </div>
    <script src='~/Areas/Master/JS/TaxSetup.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/agGridHelper.js' type="text/javascript"></script>
    <link href="~/Areas/Master/CSS/TaxSetup.css" rel="stylesheet" type="text/css"  />
</body>