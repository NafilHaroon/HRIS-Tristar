<div ng-app="HRIS">
    <div ng-controller="DocumentTypeController" ng-init="formLoaded()" id="ngForm">
        <fieldset>
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Document Type</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button ng-click="tbSearch()" id="btnFind" class="find htmlactionlink" title="Click to Search Document Type from lookup list" />
                                <button type="button" id="btnRecall" ng-click="tbRecall()" title="Click to recall existing Document Type" class="recall" />
                                <button type="button" id="btnAdd" ng-click="tbAdd()" title="Click to create new Document Type" class="add" />
                                <button type="button" id="btnEdit" title="Click to edit this Document Type" class="edit" />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Save the current record" class="save" />
                                <button type="button" id="btnUndo" ng-click="tbUndo()" title="Click to clear the request" class="undo" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="primaryKey">Document Type Id</label>
                        </td>
                        <td>
                            <input type="text" id="txtDocumentTypeId" ng-model="DocumentType.DocumentTypeId"  numbers-only  ng-keyup="$event.keyCode == 13 ? getDocumentTypeById(DocumentType.DocumentTypeId) : null" maxlength="2" class="form-control tb60 tbRA" />
                        </td>
                        <td>
                            <div class="form-check">
                                <input type="checkbox" ng-model="DocumentType.IsActive" class="form-check-input" id="chkActive" disabled />
                                <label class="form-check-label" for="chkActive">Is Active?</label>
                            </div>
                        </td>
                        <td colspan="4" />
                        <td colspan="2" />
                        <td />
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Document Type Name</label>
                        </td>
                        <td>
                            <input type="text" ng-model="DocumentType.DocumentTypeName" id="txtDocumentTypeName" maxlength="50" class="form-control tb200" />
                        </td>
                    </tr>

                    <tr>
                        <td />
                        <td>
                            <div class="form-check">
                                <input type="checkbox" ng-model="DocumentType.Mandatory" class="form-check-input" id="chkMandatory" disabled />
                                <label class="form-check-label" for="chkMandatory">Mandatory?</label>
                            </div>
                        </td>
                        <td>
                            <div class="form-check">
                                <input type="checkbox" ng-model="DocumentType.Expires" class="form-check-input" id="chkExpire" disabled />
                                <label class="form-check-label" for="chkExpire">Expire?</label>
                            </div>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="4">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>

            <footer>
                <ng-include src="'/HRIS/Helper/Pages/Footer.html'" />
            </footer>
        </fieldset>
    </div>
    <script src='~/Areas/Master/JS/DocumentType.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/SearchHelper.js' type="text/javascript"></script>
</div>
