<body ng-app="HRIS">
    <div ng-controller="LeaveTypeController" ng-init="formLoaded()" id="ngForm">
        <form id="frmLeaveType">
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Leave Type</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button ng-click="tbSearch()" id="btnFind" class="find htmlactionlink" title="Click to Search Leave Type from lookup list" />
                                <button type="button" id="btnRecall" ng-click="tbRecall()" title="Click to recall existing Leave Type" class="recall" />
                                <button type="button" id="btnAdd" ng-click="tbAdd()" title="Click to create new Bank" class="add" />
                                <button type="button" id="btnEdit" title="Click to edit this Leave Type" class="edit" />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Save the current record" class="save" />
                                <button type="button" id="btnUndo" ng-click="tbUndo()" title="Click to clear the request" class="undo" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="primaryKey">Leave Type Id</label>
                        </td>
                        <td>
                            <input type="text" id="txtLeaveTypeId" ng-model="LeaveType.LeaveTypeId" numbers-only ng-keyup="$event.keyCode == 13  ? getLeaveTypeByIode(LeaveType.LeaveTypeId) : null" maxlength="2" class="form-control tb60 tbRA" />
                            <input type="hidden" id="hdLeaveType" ng-model="LeaveType.LeaveTypeId" />
                        </td>
                        <td>
                            <div class="form-check">
                                <input type="checkbox" ng-model="LeaveType.IsActive" class="form-check-input" id="chkActive" disabled />
                                <label class="form-check-label" for="chkActive">Is Active?</label>
                            </div>
                        </td>
                        <td colspan="4" />
                        <td colspan="2" />
                        <td />
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Leave Type Desc</label>
                        </td>
                        <td>
                            <input type="text" id="txtLeaveTypeName" ng-model="LeaveType.LeaveTypeName" maxlength="50 " class="tb250" onkeypress="return isText(event)" />
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Default Days</label>
                        </td>
                        <td>
                            <input type="number" ng-model="LeaveType.DefaultDays" maxlength="2" onkeypress="return isNumberKey(event)" min="0" max="99" class="tb60 tbRA" />
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label>Upload Indicator</label>
                        </td>
                        <td>
                            <input type="text" ng-model="LeaveType.UploadIndicator" maxlength="3" class="tb60" />
                        </td>
                        <td>
                            <label>H/D Upload Indicator</label>
                        </td>
                        <td>
                            <input type="text" ng-model="LeaveType.HDUploadIndicator" maxlength="5" class="tb100" />
                        </td>
                    </tr>

                    <tr>
                        <td colspan="4">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>
            <footer>
                <ng-include src="'/HRIS/Helper/Pages/Footer.html'" />
            </footer>
        </form>
    </div>
    <script src='~/Areas/Master/JS/LeaveType.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/SearchHelper.js' type="text/javascript"></script>
</body>

