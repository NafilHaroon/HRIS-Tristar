<body ng-app="HRIS">
    <div ng-controller="QualificationController" ng-init="formLoaded()" id="ngForm">
        <form id="frmQualification">
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Qualification</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button ng-click="tbSearch()" id="btnFind" class="find" title="Click to Search Qualification from lookup list" />
                                <button type="button" id="btnRecall" ng-click="tbRecall()" title="Click to recall existing record" class="recall" />
                                <button type="button" id="btnAdd" ng-click="tbAdd()" title="Click to create new Qualification" class="add" />
                                <button type="button" id="btnEdit" title="Click to edit this Qualification" class="edit" />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Save the current record" class="save" />
                                <button type="button" id="btnUndo" ng-click="tbUndo()" title="Click to clear the request" class="undo" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="primaryKey">Qualification Id</label>
                        </td>
                        <td>
                            <input type="text" id="txtQualificationId" ng-model="Qualification.QualificationId" ng-keyup="$event.keyCode == 13  ? getQualificationById(Qualification.QualificationId) : null" maxlength="3" class="form-control tb60 tbRA" />
                        </td>
                        <td>
                            <div class="form-check">
                                <input type="checkbox" ng-model="Qualification.IsActive" class="form-check-input" id="chkActive" disabled />
                                <label class="form-check-label" for="chkActive">Is Active?</label>
                            </div>
                        </td>
                        <td colspan="2" />
                        <td colspan="3" />
                        <td colspan="2" />
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Qualification Name</label>
                        </td>
                        <td>
                            <input type="text" id="txtQualificationName" ng-model="Qualification.QualificationName" maxlength="50" class="form-control tb250" />
                        </td>
                        <td colspan="2" />
                        <td colspan="4" rowspan="6">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>

            <footer>
                <ng-include src="'/HRIS/Helper/Pages/Footer.html'" />
            </footer>
        </form>
    </div>
    <script src='~/Areas/Master/JS/Qualification.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/SearchHelper.js' type="text/javascript"></script>
</body>

