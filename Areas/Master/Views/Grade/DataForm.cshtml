<body ng-app="HRIS">
    <div ng-controller="GradeController" ng-init="formLoaded()" id="ngForm" >
        <fieldset>
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Grade</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button ng-click="tbSearch()" id="btnFind" class="find" title="Click to Search Grade from lookup list" />
                                <button type="button" id="btnRecall" ng-click="tbRecall()" title="Click to recall existing record" class="recall" />
                                <button type="button" id="btnAdd" ng-click="tbAdd()" title="Click to create new Grade" class="add" />
                                <button type="button" id="btnEdit" title="Click to edit this Grade" class="edit" />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Save the current record" class="save" />
                                <button type="button" id="btnUndo" ng-click="tbUndo()" title="Click to clear the request" class="undo" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="primaryKey">Grade Id</label>
                        </td>
                        <td>
                            <input type="text" id="txtGradeId" ng-model="Grade.GradeId"  numbers-only  ng-keyup="$event.keyCode == 13  ? getGradeById(Grade.GradeId) : null" maxlength="3" class="form-control tb60 tbRA" />
                        </td>
                        <td>
                            <div class="form-check">
                                <input type="checkbox" ng-model="Grade.IsActive" class="form-check-input" id="chkActive" disabled />
                                <label class="form-check-label" for="chkActive">Is Active?</label>
                            </div>
                        </td>
                        <td colspan="4" />
                        <td colspan="2" />
                        <td />
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Grade Name</label>
                        </td>
                        <td>
                            <input type="text" id="txtGradeName" ng-model="Grade.GradeName" maxlength="50" class="form-control tb250" />
                        </td>
                        <td colspan="2" />
                        <td colspan="4" rowspan="3" valign="top">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Grade #</label>
                        </td>
                        <td>
                            <input type="text" ng-model="Grade.GradeNo" maxlength="4" class="form-control tb100" />
                        </td>
                    </tr>
                </table>
            </div>

            <footer>
                <ng-include src="'/HRIS/Helper/Pages/Footer.html'" />
            </footer>
        </fieldset>
    </div>
    <script src='~/Areas/Master/JS/Grade.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/SearchHelper.js' type="text/javascript"></script>
</body>
</html>

