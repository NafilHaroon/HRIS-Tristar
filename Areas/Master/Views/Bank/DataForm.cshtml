<div ng-app="HRIS">
    <div ng-controller="BankController" ng-init="formLoaded()" id="ngForm">
        <fieldset>
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Bank</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button ng-click="tbSearch()" id="btnFind" class="find" title="Click to Search Bank from lookup list" />
                                <button type="button" id="btnRecall" ng-click="tbRecall()" title="Click to recall existing record" class="recall" />
                                <button type="button" id="btnAdd" ng-click="tbAdd()" title="Click to create new Bank" class="add" />
                                <button type="button" id="btnEdit" title="Click to edit this Bank" class="edit" />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Save the current record" class="save" />
                                <button type="button" id="btnUndo" ng-click="tbUndo()" title="Click to clear the request" class="undo" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="primaryKey">Bank Id</label>
                        </td>
                        <td>
                            <input type="text" id="txtBankId" ng-model="Bank.BankId"  numbers-only  ng-keyup="$event.keyCode == 13  ? getBankById(Bank.BankId) : null" maxlength="3" class="form-control tb60 tbRA" />
                        </td>
                        <td>
                            <div class="form-check">
                                <input type="checkbox" ng-model="Bank.IsActive" class="form-check-input" id="chkActive" disabled />
                                <label class="form-check-label" for="chkActive">Is Active?</label>
                            </div>
                        </td>
                        <td colspan="2">
                            <div class="form-check">
                                <input type="checkbox" ng-model="Bank.EmployeeBankDetail" class="form-check-input" id="chkEmpDetail" disabled />
                                <label class="form-check-label" for="chkEmpDetail">Show Employee Bank Detail in Letter?</label>
                            </div>
                        </td>
                        <td colspan="3" />
                        <td colspan="2" />
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Bank Name</label>
                        </td>
                        <td>
                            <input type="text" id="txtBankName" ng-model="Bank.BankName" maxlength="50" class="form-control tb250" />
                        </td>
                        <td colspan="2" />
                        <td colspan="4" rowspan="6">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Account #</label>
                        </td>
                        <td>
                            <input type="text" ng-model="Bank.AccountNo" maxlength="25" class="form-control tb150" />
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Contact Person</label>
                        </td>
                        <td>
                            <input type="text" ng-model="Bank.ContactPerson" maxlength="30" class="form-control tb200" />
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Address</label>
                        </td>
                        <td colspan="3" rowspan="4">
                            <textarea id="txtAddress" rows="5" cols="50" maxlength="200" class="form-control tb300" ng-model="Bank.Address"></textarea>
                        </td>
                    </tr>
                    <tr />
                    <tr />
                    <tr />
                    <tr>
                        <td>
                            <label>Bank Letter Header</label>
                        </td>
                        <td colspan="5">
                            <textarea id="txtLetterHead" rows="5" cols="50" maxlength="500" class="form-control tb500" ng-model="Bank.HeaderText"></textarea>
                        </td>
                    </tr>
                </table>
            </div>

            <footer>
                <ng-include src="'/HRIS/Helper/Pages/Footer.html'" />
            </footer>
        </fieldset>
    </div>
    <script src='~/Areas/Master/JS/Bank.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/SearchHelper.js' type="text/javascript"></script>
</div>


