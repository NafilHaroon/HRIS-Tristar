<body ng-app="HRIS">
    <div ng-controller="DepartmentController" ng-init="formLoaded()" id="ngForm">
        <fieldset>
            <div id="divMain" class="float-left">
                <table class="mainTable">
                    <tr class="form-title-bg">
                        <td colspan="5">
                            <p class="form-title">Department</p>
                        </td>
                        <td colspan="5">
                            <div id="divHToolbar" class="float-right">
                                <button ng-click="tbSearch()" id="btnFind" class="find htmlactionlink" title="Click to Search Department from lookup list" />
                                <button type="button" id="btnRecall" ng-click="tbRecall()" title="Click to recall existing Department" class="recall" />
                                <button type="button" id="btnEdit" title="Click to edit this Department" class="edit" />
                                <button type="button" id="btnSave" ng-click="tbSave()" title="Click to Save the current record" class="save" />
                                <button type="button" id="btnUndo" ng-click="tbUndo()" title="Click to clear the request" class="undo" />
                                <button type="button" id="btnExit" ng-click="tbExit()" title="Click to close this window and go back to main menu" class="exit" />
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label class="primaryKey">Department Code</label>
                        </td>
                        <td>
                            <input type="text" id="txtDepartmentCode" ng-model="Department.DepartmentCode" ng-keyup="$event.keyCode == 13  ? getDepartmentByCode(Department.DepartmentCode) : null" maxlength="2" class="form-control tb60 tbRA" />
                            <input type="hidden" id="hdDepartmentCode" ng-model="Department.DepartmentCode" />
                        </td>
                        <td>
                            <div class="form-check">
                                <input type="checkbox" ng-model="Department.IsActive" class="form-check-input" id="chkActive" disabled />
                                <label class="form-check-label" for="chkActive">Is Active?</label>
                            </div>
                        </td>
                        <td colspan="4" />
                        <td colspan="2" />
                        <td />
                    </tr>

                    <tr>
                        <td>
                            <label class="mandatoryKey">Department Name</label>
                        </td>
                        <td>
                            <input type="text" ng-model="Department.DepartmentName" class="form-control tb200" readonly />
                        </td>
                    </tr>

                    <tr>
                        <td>
                            <label>HFM Sub Category</label>
                        </td>
                        <td>
                            <select ng-options="sc.SubCategoryId as sc.SubCategoryName for sc in lstHFMS" ng-model="Department.HFMSubCategoryId" class="form-control tb300" id="ddSubCategory">
                                <option value="">-Select HFM Sub Category-</option>
                            </select>
                        </td>
                    </tr>

                    <tr>
                        <td colspan="4">
                            <div class="validation-summary-errors" ng-if="errors && errors.length > 0">
                                Validation Errors:<br />
                                <span data-ng-repeat="error in errors">{{error}}<br /></span>
                            </div>
                        </td>
                    </tr>
                </table>
            </div>

            <footer>
                <ng-include src="'/HRIS/Helper/Pages/Footer.html'" />
            </footer>
        </fieldset>
    </div>
    <script src='~/Areas/Master/JS/Department.js' type="text/javascript"></script>
    <script src='~/Scripts/Agility/SearchHelper.js' type="text/javascript"></script>
</body>