<body>
    <div id="divBody">
        <script type="text/javascript">
            showFormLoading();
        </script>
        <input type="hidden" id="hdnSession" data-value="@Request.RequestContext.HttpContext.Session["UserId"]" />
        @RenderBody()
    </div>
</body>
</html>

<div id="dialog-wait-large" style="display: none; overflow:hidden;">
    <h3>Requested screen is being prepared for you....</h3>
    <marquee>
        <h3 style="color:maroon;">Sit back and relax while we are processing your request</h3>
    </marquee>
    <img src="~/Content/Images/processing-halfcircle.gif" height="68%" width="88%" style="left:10px; vertical-align:middle;" />
</div>

<div id="dialog-wait-small" style="display: none; overflow:hidden;">
    <img src="~/Content/Images/processing.gif" class="waitImgSmall" />
    <marquee><h3 style="color:maroon;">Please wait while we are processing your request....</h3></marquee>
</div>

<div id="dialog-delete" style="display: none; height:200px; width:400px; overflow:hidden;">
    <table border="0">
        <tr>
            <td rowspan="2">
                <img src="~/Content/Images/redalert.gif" height="100" width="100" style="vertical-align:middle;" />
            </td>
            <td>
                <h3 style="color:red; font-size:medium;">Are you sure you want to delete selected entry permanently?</h3>
            </td>
        </tr>
        <tr>
            <td>Remember that this action is irreversible!</td>
        </tr>
    </table>
</div>

<div id="dialog-Approved" style="display: none; height: 200px; width: 400px; overflow: hidden; ">

</div>

<div id="divAddAttachment" style="display: none">
</div>

<div id="divDeleteAttachment" style="display: none">
    <p>
        <span class="ui-icon ui-icon-trash" style="float: left; margin: 0 7px 20px 0;"></span>
        Are you sure want to delete selected Attachment?
    </p>
</div>

<script type="text/javascript">
    $.ajaxSetup({ cache: false });

    $(document).ready(function () {
        $("input:text").focus(function () { $(this).select(); });
    });
    window.RootUrl = '@Url.Content("~/")';
</script>