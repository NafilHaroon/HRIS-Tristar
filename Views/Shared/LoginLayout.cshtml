<link href='~/Areas/Common/CSS/LogIn.css' rel="stylesheet" type="text/css" />
<script src='~/Scripts/jquery-3.3.1.min.js' type="text/javascript"></script>
<script src='~/Scripts/jquery-ui-1.12.1.min.js' type="text/javascript"></script>

<head>
    <title>Agility PK HRIS ver 1.3.2</title>
    <link rel="shortcut icon" href="~/Content/Icon/agility_pri_fc_proc.ico" type="image/ico" />
</head>
<div class="divVerticalHalf">
    <div class="divRow">
        <div class="divAppLogo">
            <img src="~/Content/Images/HRIS_Logo 2.png" class="appLogo" />
            <p class="site-title">Agility Pakistan HRIS</p>
            <p class="site-subtitle">Change the way you engage with your talent!</p>
        </div>
    </div>
    <div class="divDisclaimer">
        <b>Disclaimer:</b>This web portal is not for public use and require exclusive credentials & rights to access containing functionalities.
        If you are the legitimate user, please enter your Pakistan Portal User Id and Password to start surfing this portal.
        If you do not possess valid id however you are Agility PK employee and some of the containing functionalities pertain to your business needs
        please raise System Access Request (SAR) online.
    </div>
</div>

<div class="divVerticalHalf">
    <div class="divRow">
        <div class="divGILLogo">
            <img class="gilLogo" src='~/Content/Images/Agility_GIL_Logo.bmp' />
        </div>
    </div>
    <div class="divCellLogin">
        @RenderBody()
    </div>
</div>
<footer>
    <span class="developer">
        Developed and Maintained by Agility Pakistan IT Department
    </span>
</footer>

